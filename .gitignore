# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

/public/assets
.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/database.yml
/config/ssl/*

/public/packs
/public/packs-test
/node_modules
/node_modules.*
/yarn-error.log
yarn-debug.log*
.yarn-integrity
.idea/
public/uploads/

.env
.env.*

# Azure Bicep build artifacts
devops/azure/*.json

dump.rdb

# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local
*.DS_Store

/spec/support/real-arch-signed.pdf

# Local-only invoice and database test data
/claims_ai_service_documentation/Test Data/
/claims_ai_service_ddl/**/testdata*/
/.codex_tmp/

# Nest build output
/claims_ai_service/dist/
/claims_ai_service/.nestjs_cache/

# scratchpad
deleteme.*

/devops/docker/**/*.tar.gz

/allure-report/
/allure-results/
/cypress/downloads/
/cypress/screenshots/

.npm/

# ignore vscode files except the settings.json
.vscode/*
!.vscode/settings.json

# Local client-video production work
/claims_ai_service_video/
/claims_ai_service_documentation/client_video_*.md
/claims_ai_service_documentation/advanced_solutions_cinematic_brand_film_v1.md
/claims_ai_service_documentation/Test Data/demo1_aug4_ASHP-WOOD_VENT/01_Mini_Home_Energy_Solutions_Invoice_missing_ESP_code.pdf
/claims_ai_service_documentation/Test Data/demo1_aug4_ASHP-WOOD_VENT/04_WETT_Report_corrected_models.pdf
